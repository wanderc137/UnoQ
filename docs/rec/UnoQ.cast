[51.809, "o", "\u001b[90m 174\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(Serial.available()\u001b[90m \u001b[39;49;00m>\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[51.864, "o", "\u001b[90m 175\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mString\u001b[90m \u001b[39;49;00mlinea\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mleerLinea();\u001b[90m\u001b[39;49;00m\n"]
[51.919, "o", "\u001b[90m 176\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[51.974, "o", "\u001b[90m 177\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m// Ignorar líneas vacías\u001b[39;49;00m\n"]
[52.029, "o", "\u001b[90m 178\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(linea.length()\u001b[90m \u001b[39;49;00m==\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[52.084, "o", "\u001b[90m 179\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
