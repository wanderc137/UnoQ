[52.304, "o", "\u001b[90m 183\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m// Extraer primer token para comparación case-insensitive\u001b[39;49;00m\n"]
