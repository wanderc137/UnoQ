[105.975, "o", "\u001b[90m┌─ unoq_gpio_control.ino · ejecutarRead() y ejecutarWrite() ────────────────────────────────────────────\u001b[0m\n"]
[105.975, "o", "\u001b[90m 435\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mejecutarRead\u001b[39;49;00m(\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mpin)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[106.03, "o", "\u001b[90m 436\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mstate\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mdigitalRead(pin);\u001b[90m\u001b[39;49;00m\n"]
[106.085, "o", "\u001b[90m 437\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mresponder(\u001b[33m\"\u001b[39;49;00m\u001b[33mOK \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m \u001b[39;49;00m+\u001b[90m \u001b[39;49;00mString(state));\u001b[90m\u001b[39;49;00m\n"]
[106.14, "o", "\u001b[90m 438\u001b[0m\u001b[90m │ \u001b[0m}\u001b[90m\u001b[39;49;00m\n"]
[106.195, "o", "\u001b[90m 439\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[106.25, "o", "\u001b[90m 440\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// ─── ejecutarWrite() ──────────────────────────────────────────────\u001b[39;49;00m\n"]
[106.305, "o", "\u001b[90m 441\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mejecutarWrite\u001b[39;49;00m(\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mpin,\u001b[90m \u001b[39;49;00m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mvalor)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[106.36, "o", "\u001b[90m 442\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// Configurar el pin como OUTPUT antes de escribir\u001b[39;49;00m\n"]
[106.415, "o", "\u001b[90m 443\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// (si ya era OUTPUT, pinMode no hace daño repetirlo)\u001b[39;49;00m\n"]
[106.47, "o", "\u001b[90m 444\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mpinMode(pin,\u001b[90m \u001b[39;49;00mOUTPUT);\u001b[90m\u001b[39;49;00m\n"]
[106.525, "o", "\u001b[90m 445\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mdigitalWrite(pin,\u001b[90m \u001b[39;49;00mvalor);\u001b[90m\u001b[39;49;00m\n"]
[106.58, "o", "\u001b[90m 446\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[106.635, "o", "\u001b[90m 447\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mstate\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mdigitalRead(pin);\u001b[90m    \u001b[39;49;00m\u001b[90m// Leer de vuelta para confirmar\u001b[39;49;00m\n"]
[106.69, "o", "\u001b[90m 448\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mresponder(\u001b[33m\"\u001b[39;49;00m\u001b[33mOK \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m \u001b[39;49;00m+\u001b[90m \u001b[39;49;00mString(state));\u001b[90m\u001b[39;49;00m\n"]
[106.745, "o", "\u001b[90m└───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
