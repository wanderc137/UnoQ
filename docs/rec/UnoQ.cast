[128.995, "o", "\u001b[90m┌─ unoq_gpio_control.py · conexión y envío ─────────────────────────────────────────────────────────────\u001b[0m\n"]
[128.995, "o", "\u001b[90m  57\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mconnect_serial\u001b[39;49;00m(port: \u001b[96mstr\u001b[39;49;00m, baud: \u001b[96mint\u001b[39;49;00m, timeout: \u001b[96mfloat\u001b[39;49;00m) -> serial.Serial:\u001b[90m\u001b[39;49;00m\n"]
[129.05, "o", "\u001b[90m  58\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Abre la conexión serial con la UNO Q.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[129.105, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[129.16, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0m        ser = serial.Serial(port, baud, timeout=timeout)\u001b[90m\u001b[39;49;00m\n"]
[129.215, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# Esperar a que la placa se inicialice y envíe READY\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[129.27, "o", "\u001b[90m  62\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m[*] Conectando a \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mport\u001b[33m}\u001b[39;49;00m\u001b[33m a \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mbaud\u001b[33m}\u001b[39;49;00m\u001b[33m baud...\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[129.325, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0m        time.sleep(\u001b[94m0.5\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[129.38, "o", "\u001b[90m  64\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m ser\u001b[90m\u001b[39;49;00m\n"]
[129.435, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m serial.SerialException \u001b[94mas\u001b[39;49;00m e:\u001b[90m\u001b[39;49;00m\n"]
[129.49, "o", "\u001b[90m  66\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mERROR: No se pudo abrir el puerto \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mport\u001b[33m}\u001b[39;49;00m\u001b[33m: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00me\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[129.545, "o", "\u001b[90m  67\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33m       Verifica que la placa esté conectada y el puerto sea correcto.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[129.6, "o", "\u001b[90m  68\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33m       Puedes especificar el puerto con --port o -p.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[129.655, "o", "\u001b[90m  69\u001b[0m\u001b[90m │ \u001b[0m        sys.exit(\u001b[94m1\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[129.71, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[129.765, "o", "\u001b[90m  71\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[129.82, "o", "\u001b[90m  72\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mwait_ready\u001b[39;49;00m(ser: serial.Serial) -> \u001b[96mbool\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[129.875, "o", "\u001b[90m  73\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Espera el mensaje UNOQ_GPIO_READY de la placa.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[129.93, "o", "\u001b[90m  74\u001b[0m\u001b[90m │ \u001b[0m    start = time.time()\u001b[90m\u001b[39;49;00m\n"]
[129.985, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mwhile\u001b[39;49;00m time.time() - start < DEFAULT_TIMEOUT:\u001b[90m\u001b[39;49;00m\n"]
[130.04, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m        line = ser.readline().decode(\u001b[33m\"\u001b[39;49;00m\u001b[33mutf-8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, errors=\u001b[33m\"\u001b[39;49;00m\u001b[33mreplace\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).strip()\u001b[90m\u001b[39;49;00m\n"]
[130.095, "o", "\u001b[90m  77\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m line == READY_MESSAGE:\u001b[90m\u001b[39;49;00m\n"]
[130.15, "o", "\u001b[90m  78\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m[*] Placa detectada: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mline\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[130.205, "o", "\u001b[90m  79\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m \u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[130.26, "o", "\u001b[90m  80\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m line:\u001b[90m\u001b[39;49;00m\n"]
[130.315, "o", "\u001b[90m  81\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m[!] Mensaje inesperado: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mline\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[130.37, "o", "\u001b[90m  82\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mreturn\u001b[39;49;00m \u001b[94mFalse\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[130.425, "o", "\u001b[90m  83\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
