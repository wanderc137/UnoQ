[142.813, "o", "\u001b[90m┌─ unoq_remote.py · LEDs por ADB ───────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[142.813, "o", "\u001b[90m 216\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_adb\u001b[39;49;00m(cmd):\u001b[90m\u001b[39;49;00m\n"]
[142.868, "o", "\u001b[90m 217\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Ejecuta un comando en el Linux de la placa vía ADB.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[142.923, "o", "\u001b[90m 218\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[142.978, "o", "\u001b[90m 219\u001b[0m\u001b[90m │ \u001b[0m        r = subprocess.run([\u001b[33m\"\u001b[39;49;00m\u001b[33madb\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mshell\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, cmd],\u001b[90m\u001b[39;49;00m\n"]
[143.033, "o", "\u001b[90m 220\u001b[0m\u001b[90m │ \u001b[0m                          capture_output=\u001b[94mTrue\u001b[39;49;00m, text=\u001b[94mTrue\u001b[39;49;00m, timeout=\u001b[94m5\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[143.088, "o", "\u001b[90m 221\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m r.stdout.strip()\u001b[90m\u001b[39;49;00m\n"]
[143.143, "o", "\u001b[90m 222\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m \u001b[96mException\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[143.198, "o", "\u001b[90m 223\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[143.253, "o", "\u001b[90m 224\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[143.308, "o", "\u001b[90m 225\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_liberar_led\u001b[39;49;00m(nombre):\u001b[90m\u001b[39;49;00m\n"]
[143.363, "o", "\u001b[90m 226\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Suelta el LED del kernel para poder controlarlo nosotros.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[143.418, "o", "\u001b[90m 227\u001b[0m\u001b[90m │ \u001b[0m    _adb(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mecho none > /sys/class/leds/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mnombre\u001b[33m}\u001b[39;49;00m\u001b[33m/trigger\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[143.473, "o", "\u001b[90m 228\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[143.528, "o", "\u001b[90m 229\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_led_escribir\u001b[39;49;00m(nombre, valor):\u001b[90m\u001b[39;49;00m\n"]
[143.583, "o", "\u001b[90m 230\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Enciende (255) o apaga (0) un LED.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[143.638, "o", "\u001b[90m 231\u001b[0m\u001b[90m │ \u001b[0m    _adb(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mecho \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mvalor\u001b[33m}\u001b[39;49;00m\u001b[33m > /sys/class/leds/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mnombre\u001b[33m}\u001b[39;49;00m\u001b[33m/brightness\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
