[38.094, "o", "\u001b[90m┌─ unoq_gpio_control.ino · setup() ─────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[38.094, "o", "\u001b[90m 145\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92msetup\u001b[39;49;00m()\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[38.149, "o", "\u001b[90m 146\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mSerial.begin(BAUD_RATE);\u001b[90m\u001b[39;49;00m\n"]
[38.204, "o", "\u001b[90m 147\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[38.259, "o", "\u001b[90m 148\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// Inicializar matriz LED\u001b[39;49;00m\n"]
[38.314, "o", "\u001b[90m 149\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mmatrix.begin();\u001b[90m\u001b[39;49;00m\n"]
[38.369, "o", "\u001b[90m 150\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mmatrix.textFont(Font_5x7);\u001b[90m\u001b[39;49;00m\n"]
[38.424, "o", "\u001b[90m 151\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mmatrix.textScrollSpeed(\u001b[94m100\u001b[39;49;00m);\u001b[90m\u001b[39;49;00m\n"]
[38.479, "o", "\u001b[90m 152\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[38.534, "o", "\u001b[90m 153\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// Configurar todos los pines digitales como INPUT (alta impedancia, seguro)\u001b[39;49;00m\n"]
[38.589, "o", "\u001b[90m 154\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mfor\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mp\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mPIN_MIN;\u001b[90m \u001b[39;49;00mp\u001b[90m \u001b[39;49;00m<=\u001b[90m \u001b[39;49;00mPIN_MAX;\u001b[90m \u001b[39;49;00mp++)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[38.644, "o", "\u001b[90m 155\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mpinMode(p,\u001b[90m \u001b[39;49;00mINPUT);\u001b[90m\u001b[39;49;00m\n"]
[38.699, "o", "\u001b[90m 156\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[38.754, "o", "\u001b[90m 157\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[38.809, "o", "\u001b[90m 158\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// Configurar pines PWM como OUTPUT\u001b[39;49;00m\n"]
[38.864, "o", "\u001b[90m 159\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mfor\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mi\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m;\u001b[90m \u001b[39;49;00mi\u001b[90m \u001b[39;49;00m<\u001b[90m \u001b[39;49;00mPWM_COUNT;\u001b[90m \u001b[39;49;00mi++)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[38.919, "o", "\u001b[90m 160\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mpinMode(PWM_PINS[i],\u001b[90m \u001b[39;49;00mOUTPUT);\u001b[90m\u001b[39;49;00m\n"]
[38.974, "o", "\u001b[90m 161\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mdigitalWrite(PWM_PINS[i],\u001b[90m \u001b[39;49;00mLOW);\u001b[90m\u001b[39;49;00m\n"]
[39.029, "o", "\u001b[90m 162\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
